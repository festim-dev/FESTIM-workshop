{
    // Uses the same prebuilt image as Binder, built by .github/workflows/build-image.yml.
    // Building the conda environment at container-create time took tens of minutes and ran
    // out of resources on the default Codespaces machine, so we pull instead of solve.
    //
    // We build FROM binder/Dockerfile rather than naming the image directly: that file is
    // generated by the image workflow as `FROM <registry>/<owner>/festim-workshop:<shortSHA>`,
    // so a codespace always gets the image built for the commit it was opened on (no stale
    // `:latest`), and a fork automatically uses the fork's own image.
    //
    // DISK: the default 2-core / 4-core codespaces have a 32 GB disk, and while the image is
    // pulled the compressed and unpacked copies of its conda layer sit on disk together.
    // A 6.9 GB (compressed) conda layer failed with "no space left on device". Keep the image
    // small (CPU-only torch, vtk-base instead of the full vtk) -- see environment.yml.
    "name": "festim-workshop",
    "build": {
        "dockerfile": "../binder/Dockerfile",
        "context": ".."
    },

    // repo2docker images run as jovyan (uid 1000) and install into /srv/conda/envs/notebook
    // -- not into an env named after `name:` in environment.yml, which repo2docker discards.
    "remoteUser": "jovyan",

    // conda is activated by /etc/profile.d/activate-conda.sh, which only runs for login
    // shells; without this the VS Code terminal and Jupyter extension would miss the env.
    "remoteEnv": {
        "PATH": "/srv/conda/envs/notebook/bin:${containerEnv:PATH}"
    },

    // PyVista/VTK need an X display to render, even for the notebook (html) backend; without
    // one VTK aborts the kernel. Xvfb (from apt.txt) is started by postStartCommand on :99.
    "containerEnv": {
        "DISPLAY": ":99",
        // Default PyVista to the self-contained "html" notebook backend. Its default ("trame")
        // shows an iframe pointing at a server on a random localhost port, which a codespace
        // does not forward, so the plot comes up blank (affects any cell that never calls
        // pyvista.set_jupyter_backend).
        "PYVISTA_JUPYTER_BACKEND": "html"
    },

    // Deliberately NO "hostRequirements". It filters the machine-type list, and asking for
    // storage 64gb matched nothing (the common Codespaces tiers ship 32 GB), which surfaces as
    // "A codespace cannot be created because no machine types are available" with Machine
    // type: None. If you ever re-add a floor, set only cpus/memory, never storage, and check
    // the org's allowed machine types first.

    // Once per codespace: turn the MyST .md notebooks into .ipynb so VS Code opens them as
    // notebooks. Runs before the editor connects (waitFor), so they are there on first load.
    "onCreateCommand": "bash .devcontainer/on-create.sh",
    "waitFor": "onCreateCommand",

    // Every start, including resuming a stopped codespace: (re)start the virtual display.
    "postStartCommand": "bash .devcontainer/start-xvfb.sh",

    "customizations": {
        "codespaces": {
            // Open on the first tutorial. The *.ipynb association below forces the notebook editor:
            // without it, a notebook opened at boot can render as raw JSON.
            "openFiles": ["book/content/01_getting_started/01_simple_simulation.ipynb"]
        },
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/srv/conda/envs/notebook/bin/python",
                // Always open notebooks in the notebook editor ("jupyter-notebook" is VS Code's
                // built-in .ipynb editor), never as raw JSON text.
                "workbench.editorAssociations": {
                    "*.ipynb": "jupyter-notebook"
                },
                // The image's env is already on PATH; activation would only add noise.
                "python.terminal.activateEnvironment": false,
                // Only one environment exists here; don't make people pick it.
                "jupyter.kernels.excludePythonEnvironments": [
                    "/srv/conda/bin/python",
                    "/usr/bin/python3",
                    "/bin/python3"
                ],
                // Show the source .md files' notebook twins next to them, but hide build output.
                "files.exclude": {
                    "**/_build": true,
                    "**/__pycache__": true,
                    "**/.ipynb_checkpoints": true
                }
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter"
            ]
        }
    }
}
